 },

 "weathers": {
  "_note": "Each weather: what sets it (moves, abilities), what benefits (speed and power abilities, boosted attack types, attacks that change in it). A weather sweeper needs its weather available: its own move or ability, or (in a team read) a teammate's.",
  "rain": {"moves": ["Rain Dance"], "abilities": ["Drizzle"], "rock": "Damp Rock", "sweep_abilities": ["Swift Swim"], "other_abilities": ["Rain Dish", "Hydration", "Dry Skin"], "boosted_types": ["Water"], "boosted_moves": ["Thunder", "Weather Ball"]},
  "sun": {"moves": ["Sunny Day"], "abilities": ["Drought"], "rock": "Heat Rock", "sweep_abilities": ["Chlorophyll", "Solar Power"], "other_abilities": ["Leaf Guard", "Flower Gift"], "boosted_types": ["Fire"], "boosted_moves": ["Solar Beam", "Weather Ball"]},
  "sand": {"moves": ["Sandstorm"], "abilities": ["Sand Stream"], "rock": "Smooth Rock", "sweep_abilities": [], "other_abilities": ["Sand Veil"], "boosted_types": [], "boosted_moves": ["Weather Ball"]},
  "hail": {"moves": ["Hail"], "abilities": ["Snow Warning"], "rock": "Icy Rock", "sweep_abilities": [], "other_abilities": ["Snow Cloak", "Ice Body"], "boosted_types": [], "boosted_moves": ["Blizzard", "Weather Ball"]}
 },

 "pool": {
  "_note": "Stat signals are percentiles against every fully evolved Pokémon of the game's generation at the same level, with the default spread (trainers/config.json defaults: IVs 31, 85 EVs in every stat, neutral nature). So investment shows: 252 Speed EVs and a +Speed nature push a build past its species' default.",
  "level": 100,
  "investment_lean": 32,
  "nature_tilt": 50,
  "_investment_note": "Which attacking side a build uses: the side with more EVs (a raising nature counts as +50, a lowering one -50) when they differ by 32 or more; otherwise the side its attacks hit harder with; otherwise its higher stat."
 },

 "signals": {
  "_note": "Each signal is 0-1. 'full_at' is the count that reads as 1 (one hazard is full; two attacks of a class are full). 'scaled' attack signals multiply each attack's power by the stat it hits with, against the build's better attacking stat (a special move on a physical attacker counts for less). A status move counts by its accuracy (Sing 0.55, Toxic 0.85, Thunder Wave 1), from the game's data. Labels are what the explanations print.",
  "atk": {"kind": "stat_pct", "stat": "atk", "label": "Attack"},
  "spa": {"kind": "stat_pct", "stat": "spa", "label": "Special Attack"},
  "spe": {"kind": "stat_pct", "stat": "spe", "label": "Speed"},
  "hp": {"kind": "stat_pct", "stat": "hp", "label": "HP"},
  "attack_best": {"kind": "stat_pct", "stat": "best_attack", "label": "best attacking stat"},
  "slow": {"kind": "stat_pct", "stat": "spe", "invert": true, "label": "low Speed"},
  "bulk_phys": {"kind": "bulk_pct", "side": "physical", "label": "physical bulk (HP x Defense)"},
  "bulk_spec": {"kind": "bulk_pct", "side": "special", "label": "special bulk (HP x Sp. Def)"},
  "bulk_both": {"kind": "bulk_pct", "side": "both", "label": "overall bulk"},
  "typing": {"kind": "typing_pct", "weights": {"immune": 2, "resist": 1, "weak": -1, "very_weak": -2, "choice": -2}, "label": "defensive typing (resistances and immunities, less weaknesses)"},

  "nature_atk": {"kind": "nature", "raises": ["atk"], "label": "nature raises Attack"},
  "nature_spa": {"kind": "nature", "raises": ["spa"], "label": "nature raises Special Attack"},
  "nature_spe": {"kind": "nature", "raises": ["spe"], "label": "nature raises Speed"},
  "nature_def": {"kind": "nature", "raises": ["def"], "label": "nature raises Defense"},
  "nature_spd": {"kind": "nature", "raises": ["spd"], "label": "nature raises Sp. Def"},
  "nature_bulk": {"kind": "nature", "raises": ["def", "spd"], "label": "nature raises a defense"},
  "nature_attack": {"kind": "nature", "raises": ["matching"], "label": "nature raises the attacking stat it uses"},
  "nature_slow": {"kind": "nature", "lowers": ["spe"], "label": "nature lowers Speed"},
  "nature_mixed": {"kind": "nature", "raises": ["atk", "spa", "spe"], "lowers": ["def", "spd"], "label": "nature trades a defense for offense"},

  "ev_atk": {"kind": "evs", "stats": ["atk"], "full_at": 252, "label": "Attack EVs"},
  "ev_spa": {"kind": "evs", "stats": ["spa"], "full_at": 252, "label": "Sp. Atk EVs"},
  "ev_spe": {"kind": "evs", "stats": ["spe"], "full_at": 252, "label": "Speed EVs"},
  "ev_hp": {"kind": "evs", "stats": ["hp"], "full_at": 252, "label": "HP EVs"},

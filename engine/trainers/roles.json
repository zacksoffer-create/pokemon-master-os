  "ev_spd": {"kind": "evs", "stats": ["spd"], "full_at": 252, "label": "Sp. Def EVs"},
  "ev_bulk": {"kind": "evs", "stats": ["hp", "def", "spd"], "full_at": 504, "label": "EVs in bulk"},
  "ev_attack": {"kind": "evs", "stats": ["matching"], "full_at": 252, "label": "EVs in the attacking stat it uses"},
  "ev_offense": {"kind": "evs", "stats": ["atk", "spa"], "full_at": 252, "label": "EVs in attack"},
  "speed_iv_low": {"kind": "iv_low", "stat": "spe", "at_most": 2, "label": "Speed IV kept low"},

  "choice": {"kind": "item", "group": "choice", "label": "Choice item"},

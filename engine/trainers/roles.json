  "for_types": {"Black Sludge": ["Poison"]}
 },

 "suggestion_items": {
  "_note": "The items the solver tries for a role, on top of every item a role's signals name. Species items (Light Ball and co.) are tried only for their species.",
  "items": ["Leftovers", "Black Sludge", "Life Orb", "Choice Band", "Choice Specs", "Choice Scarf", "Expert Belt", "Focus Sash", "Light Clay", "Damp Rock", "Heat Rock", "Smooth Rock", "Icy Rock", "Lum Berry", "Chesto Berry", "Toxic Orb", "Flame Orb", "Salac Berry", "Liechi Berry", "Petaya Berry", "Shed Shell", "Muscle Band", "Wise Glasses", "Light Ball", "Thick Club", "Soul Dew"]
 },

 "ability_groups": {
  "_note": "Abilities by what they say about a build (Gen III-IV; there are none in Gen II).",
  "weather_ability": ["Drizzle", "Drought", "Sand Stream", "Snow Warning"],
  "weather_sweep_ability": ["Swift Swim", "Chlorophyll", "Solar Power"],
  "trap_ability": ["Shadow Tag", "Arena Trap", "Magnet Pull"],

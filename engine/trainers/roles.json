{
 "_note": "The role engine's one source of truth (docs/TRAINER_REPORT.md, Part 2). Every role is defined once here as a profile of signals; the classifier, the role-to-build solver, the species archetypes and the playsheet all read this file and nothing else for roles. Edit a weight, a gate, a list or a threshold here and every function follows. Signals are 0-1 values read from the build and the game's data (PokeAPI), never from usage statistics.",

 "move_categories": {
  "_note": "What each move does, for the signals. A move can sit in several categories. 'rule' reads the game's data (PokeAPI moves, move_meta, move_meta_stat_changes, rolled back to the generation); 'names' adds moves by English name where the data has no clean field. A name that doesn't exist in a generation simply never matches.",
  "attack": {"rule": "damaging", "label": "attack"},
  "priority_attack": {"rule": "damaging", "priority_at_least": 1, "exclude_names": ["Fake Out"], "label": "priority attack"},
  "setup_physical": {"rule": "user_boost", "stats": ["atk"], "names": ["Curse", "Belly Drum"], "label": "Attack setup"},
  "setup_special": {"rule": "user_boost", "stats": ["spa"], "label": "Special Attack setup"},
  "setup_speed": {"rule": "user_boost", "stats": ["spe"], "label": "Speed setup"},
  "setup_defense": {"rule": "user_boost", "stats": ["def", "spd"], "names": ["Curse"], "label": "defensive setup"},
  "recovery": {"rule": "heal_self", "names": ["Wish", "Ingrain", "Aqua Ring"], "label": "recovery"},
  "rest": {"names": ["Rest"], "label": "Rest"},
  "sleep": {"rule": "inflicts", "ailments": ["sleep", "yawn"], "label": "sleep move"},
  "sleep_talk": {"names": ["Sleep Talk"], "label": "Sleep Talk"},
  "status_infliction": {"rule": "inflicts", "ailments": ["paralysis", "sleep", "burn", "poison", "yawn", "freeze"], "label": "status move"},
  "confuse": {"rule": "inflicts", "ailments": ["confusion"], "names": ["Swagger", "Flatter"], "label": "confusion move"},
  "residual": {"names": ["Leech Seed", "Toxic", "Will-O-Wisp", "Curse", "Perish Song"], "label": "residual damage"},
  "hazard": {"names": ["Spikes", "Toxic Spikes", "Stealth Rock"], "label": "entry hazard"},
  "hazard_removal": {"names": ["Rapid Spin", "Defog"], "label": "hazard removal"},
  "cleric": {"names": ["Heal Bell", "Aromatherapy", "Wish", "Healing Wish", "Lunar Dance"], "label": "team healing"},
  "screens": {"names": ["Reflect", "Light Screen"], "label": "screen"},
  "weather": {"names": ["Rain Dance", "Sunny Day", "Sandstorm", "Hail"], "label": "weather move"},
  "weather_attack": {"names": ["Thunder", "Blizzard", "Solar Beam", "Weather Ball"], "label": "weather-boosted attack"},
  "phaze": {"rule": "force_switch", "label": "phazing move"},
  "anti_setup": {"names": ["Haze", "Perish Song", "Encore", "Yawn"], "label": "anti-setup move"},
  "trap": {"names": ["Mean Look", "Block", "Spider Web"], "label": "trapping move"},
  "partial_trap": {"rule": "damaging", "ailments": ["trap"], "label": "binding move"},
  "pursuit": {"names": ["Pursuit"], "label": "Pursuit"},
  "trick_room": {"names": ["Trick Room"], "label": "Trick Room"},
  "tailwind": {"names": ["Tailwind"], "label": "Tailwind"},
  "fake_out": {"names": ["Fake Out"], "label": "Fake Out"},
  "pivot_move": {"names": ["U-turn", "Volt Switch"], "label": "pivot move"},
  "baton_pass": {"names": ["Baton Pass"], "label": "Baton Pass"},
  "protect": {"names": ["Protect", "Detect"], "label": "Protect"},
  "substitute": {"names": ["Substitute"], "label": "Substitute"},
  "taunt": {"names": ["Taunt"], "label": "Taunt"},
  "encore": {"names": ["Encore"], "label": "Encore"},
  "trick": {"names": ["Trick", "Switcheroo"], "label": "item swap"},
  "self_ko": {"rule": "user_faints", "label": "self-KO"},
  "destiny_bond": {"names": ["Destiny Bond"], "label": "Destiny Bond"},
  "hp_gambit": {"names": ["Endeavor", "Reversal", "Flail"], "label": "low-HP gambit"},
  "counter": {"names": ["Counter", "Mirror Coat", "Metal Burst"], "label": "counterattack"},
  "ohko": {"rule": "ohko", "label": "one-hit KO move"},
  "recoil": {"rule": "recoil", "label": "recoil attack"}
 },

 "stat_changes_by_name": {
  "_note": "Moves whose stat changes PokeAPI files under 'unique' with no stat rows. Read from their effect text (move_effect_prose). Curse is the non-Ghost version.",
  "Curse": {"atk": 1, "def": 1, "spe": -1},
  "Belly Drum": {"atk": 6}
 },

 "power": {
  "_note": "Effective power for the signals: base power x accuracy x STAB (x hits for multi-hit moves), with these adjustments. Not a damage calculation; it ranks attacks against each other.",
  "stab": 1.5,
  "variable_power": {"Return": 102, "Frustration": 102, "Seismic Toss": 70, "Night Shade": 70, "Low Kick": 60, "Grass Knot": 60, "Gyro Ball": 60, "Hidden Power": 70, "Crush Grip": 60, "Wring Out": 60, "Magnitude": 71, "Punishment": 60, "Trump Card": 60, "Natural Gift": 60, "Super Fang": 60, "Psywave": 50, "Reversal": 40, "Flail": 40, "Present": 40, "Electro Ball": 60, "Heavy Slam": 60},
  "_variable_note": "Moves whose power isn't fixed: a typical value. Return and Frustration at max (102). Seismic Toss and Night Shade do level-based damage; 70 stands in for that at level 100.",
  "factor": {"Dream Eater": 0.25, "Snore": 0.25, "Focus Punch": 0.5, "Last Resort": 0.5, "Future Sight": 0.75, "Doom Desire": 0.75, "Sky Attack": 0.4, "Solar Beam": 0.4, "Razor Wind": 0.4, "Skull Bash": 0.4, "Hyper Beam": 0.4, "Giga Impact": 0.4, "Blast Burn": 0.4, "Frenzy Plant": 0.4, "Hydro Cannon": 0.4, "Rock Wrecker": 0.4, "Roar of Time": 0.4, "Outrage": 0.85, "Petal Dance": 0.85, "Thrash": 0.85, "Dig": 0.5, "Dive": 0.5, "Fly": 0.5, "Bounce": 0.5, "Shadow Force": 0.5},
  "_factor_note": "Moves that cost a turn count for less: charge and recharge moves 0.4 (without Power Herb or sun they spend a whole turn doing nothing), a turn underground, underwater or in the air 0.5; moves that only work in a condition count less; rampage moves lock you in.",
  "multi_hit_average": 3,
  "abilities": {"Technician": {"at_most": 60, "times": 1.5}, "Adaptability": {"stab": 2}, "Skill Link": {"multi_hit": 5}},
  "stat_multipliers": {
   "_note": "Abilities and items that double a stat outright. Read into the stat percentiles. Species-bound items name their species.",
   "abilities": {"Huge Power": {"atk": 2}, "Pure Power": {"atk": 2}},
   "items": {"Light Ball": {"stats": {"atk": 2, "spa": 2}, "species": ["Pikachu"]}, "Thick Club": {"stats": {"atk": 2}, "species": ["Cubone", "Marowak"]}, "Deep Sea Tooth": {"stats": {"spa": 2}, "species": ["Clamperl"]}, "Deep Sea Scale": {"stats": {"spd": 2}, "species": ["Clamperl"]}, "Metal Powder": {"stats": {"def": 2}, "species": ["Ditto"]}, "Soul Dew": {"stats": {"spa": 1.5, "spd": 1.5}, "species": ["Latias", "Latios"]}}
  }
 },

 "item_groups": {

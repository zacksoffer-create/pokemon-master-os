  "sim": {
    "class": "creative",
    "_note": "The optional run (spec §9, 'an optional simulation layer'): a seeded day-by-day field journal from the rules above and the game's own encounter tables. It's a way to see a plan's odds, never canon: run it as often as you like. One wild encounter is drawn per window per day from that window's table: on land, or, when the team can travel on water and the place has Pokémon on it, on the water a third of the time (water_weights). A team turns back after this many setbacks, or when the food runs out.",
    "setbacks_to_turn_back": 3,
    "reserve_days": 1,
    "forage_share": 0.25,

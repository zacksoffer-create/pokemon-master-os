{
  "name": "pulsefall",
  "private": true,
  "version": "1.0.0",
  "description": "Pulsefall: a personal, mobile-first rhythm arcade that turns your own MP3/M4A files into playable three-lane charts.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "deploy:pages": "bash scripts/deploy-pages.sh",
    "build:artifact": "node scripts/build-artifact.mjs",
    "eval": "vitest run --config vitest.eval.config.ts"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "5.3.0",
    "idb": "8.0.4",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "fake-indexeddb": "6.2.6",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.5",
    "workbox-window": "7.4.1"
  }
}

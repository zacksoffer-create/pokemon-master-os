   },
   {
    "section": "who",
    "text": "Their Pokémon fight as partners, not tools.",
    "rule": "bond_partner",
    "trigger": "bond_read == partnership (here partnership)"
   },
   {
    "section": "who",
    "text": "A gambler: they'll reach for the long shot.",
    "rule": "risk_high",
    "trigger": "risk_band == high (here high)"
   }
  ],
  "expect": [
   {
    "section": "expect",
    "text": "A Champion: they've won before and play like it.",
    "rule": "role_champion",
    "trigger": "is_champion == True (here True)"
   },
   {
    "section": "expect",
    "text": "They attack mostly from the physical side (18 of 24 attacks).",
    "rule": "side",
    "trigger": "their_side in ['physical', 'special'] (here physical)"
   },
   {
    "section": "expect",
    "text": "Fast where it counts: Pikachu, Charizard, Sceptile, Infernape and Heracross outspeed the typical Pokémon of the generation.",
    "rule": "fast",
    "trigger": "fast_str nonempty"
   },
   {
    "section": "expect",
    "text": "Called gambler (75), but this team reads percentage player (33): carries a gamble: Pikachu and Infernape.",
    "rule": "disagree_risk",
    "trigger": "disagree_risk nonempty"
   }
  ],
  "beat": [
   {
    "section": "beat",
    "text": "Attack with Flying: Sceptile, Infernape and Heracross are weak to it, and only Pikachu can take it.",
    "rule": "gap_top",
    "trigger": "top_gap nonempty"
   },
   {
    "section": "beat",
    "text": "Also open to Psychic (2 weak).",
    "rule": "gap_more",
    "trigger": "more_gaps_str nonempty"
   },
   {
    "section": "beat",
    "text": "Biggest single openings: Charizard to Rock; Heracross to Flying (four times the damage).",
    "rule": "very_weak",
    "trigger": "very_weak_str nonempty"
   },
   {
    "section": "beat",
    "text": "Bring a physical attacker: Sceptile, Snorlax and Heracross are physically soft.",
    "rule": "bring_side",
    "trigger": "bring in ['physical', 'special'] (here physical)"
   },
   {
